generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  name       String?
  password   String
  phone      String?
  role       Role        @default(user)
  deskripsis Deskripsi[]
  savings    Savings[]
}

model Savings {
  id             Int      @id @default(autoincrement())
  userId         Int
  Date           DateTime @default(now())
  widrawalAmount Float
  balance        Float
  user           User     @relation(fields: [userId], references: [id])
}

model Deskripsi {
  id     Int    @id @default(autoincrement())
  userId Int
  notes  String
  user   User   @relation(fields: [userId], references: [id])
}

enum Role {
  penjual
  user
}

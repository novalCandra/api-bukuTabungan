generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  penjual
  user
}

enum Type {
  Deposit
  Loss
  Withdrawal
}

enum AccountsStatus {
  ACTIVE
  DORMANT
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
}

enum Currency {
  USD
  EUR
  GBP
  NGN
  IDR
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  password        String
  phone           String?
  role            Role             @default(user)
  savingsAccounts SavingsAccount[]
  transactions    Transaction[]
  statements      Statements[]
}

model SavingsAccount {
  id             Int            @id @default(autoincrement())
  account_number String         @unique @map("account_number")
  status         AccountsStatus
  currency       String         @db.Char()
  openingBalance Decimal        @map("opening_balance") @db.Decimal(18, 2)
  openedAt       DateTime       @map("opened_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updateAt       DateTime       @updatedAt @map("update_at")
  transactions   Transaction[]
  user           User?          @relation(fields: [userId], references: [id])
  userId         Int?
  statements     Statements[]

  @@map("saing_accounts")
}

model Transaction {
  id          Int             @id @default(autoincrement())
  references  Int             @unique
  accountId   Int
  recordById  Int
  type        TransactionType
  status      AccountsStatus
  amount      Decimal         @db.Decimal()
  description String?
  createAt    DateTime        @default(now()) @map("created_at")
  updateAt    DateTime        @updatedAt @map("update_at")

  account SavingsAccount @relation(fields: [accountId], references: [id])
  // recordByUsers User           @relation("RecordyUsers", fields: [recordById], references: [id])
  user    User?          @relation(fields: [userId], references: [id])
  userId  Int?
}

model Statements {
  id               Int      @id @default(autoincrement())
  references       Int      @unique
  account_id       Int
  generatedById    Int
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  openingBalance   Decimal  @map("opening_balance") @db.Decimal(18, 2)
  totalDeposits    Decimal  @map("total_deposits") @db.Decimal(18, 2)
  totalWithdrawals Decimal  @map("total_withdrawals") @db.Decimal(18, 2)
  closingBalance   Decimal  @map("closing_balance") @db.Decimal(18, 2)
  documentKey      String?  @map("document_key")
  create_at        DateTime @default(now()) @map("created_map")

  account       SavingsAccount @relation(fields: [account_id], references: [id])
  generatedUser User           @relation(fields: [generatedById], references: [id])
}
